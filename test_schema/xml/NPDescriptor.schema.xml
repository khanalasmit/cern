 <file path="daq/schema/core.schema.xml"/>
 <file path="daq/schema/df.schema.xml"/>
</include>


 <class name="NPTriggerIn">
  <superclass name="ReadoutTrigger"/>
  <attribute name="nDataServerThreads" description="Number of threads to allocate to the boost::aio::io_server in the DataServer" type="u32" range="0..128" init-value="2"/>
  <attribute name="nIOServices" description="Number of io_services to allocate to the boost::aio::io_server in the DataServer" type="u32" range="0..128" init-value="2"/>
  <attribute name="nDescriptors" description="Number of NPRequestDescriptors to make at configure. The number of descriptors can grow beyond this at run time." type="u32" init-value="64"/>
  <attribute name="dataRequestTimeout" description="Data request timeout in microseconds" type="u32" init-value="10000"/>
  <attribute name="clearTimeout" description="Clear request timeout in microseconds" type="u32" init-value="2500000"/>
  <attribute name="managerPollInterval" description="Request manager poll interval in microseconds" type="u32" init-value="1000"/>
  <attribute name="ignoreClearXId" description="Ignore the transaction ID in Clear messages." type="bool" init-value="false"/>
 </class>

</oks-schema>
