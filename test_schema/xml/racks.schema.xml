<info name="" type="" num-of-items="1" oks-format="schema" oks-version="oks-08-03-02-14-g572fc09 built &quot;Mar 11 2021&quot;" created-by="garelli" created-on="lxplus007.cern.ch" creation-time="20050606T114308" last-modified-by="isolov" last-modified-on="pcatd79.cern.ch" last-modification-time="20210312T111805"/>

<include>
 <file path="daq/schema/core.schema.xml"/>
</include>


 <class name="RackParameters" description="Describes the HLT rack parameters.">
  <attribute name="Type" description="Defines the type of rack (XPU or dedicated EF)" type="enum" range="XPU,EF" init-value="XPU" is-not-null="yes"/>
  <attribute name="NumberOfMachines" description="Defines the number of nodes in a rack" type="u32" init-value="31" is-not-null="yes"/>
  <attribute name="NumberOfPhysicalCores" description="Defines the number of physical core in a node" type="u32" init-value="1" is-not-null="yes"/>
  <attribute name="BackEnd" description="Defines to which back-end network (ef1 or ef2) the rack is connected to" type="enum" range="ef1,ef2,none" init-value="ef1" is-not-null="yes"/>
  <attribute name="DataCollection" description="Defines to which data collection network (dc1 or dc2) the rack is connected to" type="enum" range="dc1,dc2,none" init-value="dc1" is-not-null="yes"/>
  <attribute name="BackEndBW" description="Defines the bandwidth available in the back-end network(in MB/s)" type="u32" init-value="0" is-not-null="yes"/>
  <attribute name="DataCollectionBW" description="Defines the available bandwidth in the data collection network (in MB/s)" type="u32" init-value="0" is-not-null="yes"/>
  <attribute name="CPUweight" description="Defines the type of cores in the rack with respect to the HepSpec2006 values." type="float" init-value="1" is-not-null="yes"/>
  <relationship name="PhysicalRack" class-type="Rack" low-cc="zero" high-cc="many" is-composite="no" is-exclusive="no" is-dependent="no"/>
 </class>

