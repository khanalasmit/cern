<oks-schema>

<info name="" type="" num-of-items="5" oks-format="schema" oks-version="oks-06-07-02 built &quot;Jul 14 2014&quot;" created-by="kama" created-on="pcsmu1.cern.ch" creation-time="20110707T121728" last-modified-by="kama" last-modified-on="pcatr25a.cern.ch" last-modification-time="20141107T210800"/>

<include>
 <file path="daq/schema/df.schema.xml"/>
</include>

 <class name="MIGApplication" description="Describes the MonInfoGatherer application.">
  <superclass name="Resource"/>
  <superclass name="RunControlApplicationBase"/>
  <superclass name="TemplateApplication"/>
  <attribute name="LibraryPaths" description="full path to library that contain algorithms" type="string" is-multi-value="yes" init-value="libMIGContainers.so" is-not-null="yes"/>
  <relationship name="Configurations" description="Relation to the MonInfoGatherer configuration." class-type="MIGConfiguration" low-cc="one" high-cc="many" is-composite="no" is-exclusive="no" is-dependent="no"/>
 </class>

 <class name="MIGConfiguration" description="Configuration to describe regular expressions, input and output servers and handler and algorithm to use">
  <attribute name="ProviderRegExp" description="Regular expression for matching providers" type="string" init-value=".+" is-not-null="yes"/>
  <attribute name="ObjectRegExp" description="Regular expression used to subscribe for IS server updates" type="string" init-value=".+" is-not-null="yes"/>
  <relationship name="SourceServers" description="If template application use SegmentProcEnvVarName evironment" class-type="InfrastructureBase" low-cc="one" high-cc="many" is-composite="no" is-exclusive="no" is-dependent="no"/>
  <relationship name="DestinationServers" description="If TemplateApplication use SegmentProcEvnParentName value as envrionment variable to read the destination server." class-type="InfrastructureBase" low-cc="zero" high-cc="many" is-composite="no" is-exclusive="no" is-dependent="no"/>
  <relationship name="MatchHandlers" description="First handler in this list which matches object name will be called to process object data. Typically last handler in the list should be made a catch-all handler with regular expression matching all object names." class-type="MIGMatchHandler" low-cc="zero" high-cc="many" is-composite="no" is-exclusive="no" is-dependent="no"/>
 </class>

 <class name="MIGMatchHandler">
  <attribute name="ObjectRegExp" description="Regular expression to match IS object name. With multiple MIGMatchHandler definitions only first matching MIGMatchHandler is called for a matching object name." type="string" init-value=".+" is-not-null="yes"/>
  <attribute name="Name" description="Name of the handler/container to be queried from HandlerManager" type="string" init-value="Default" is-not-null="yes"/>
  <attribute name="Parameters" description="List of extra parameters to pass to the handler/container/algorithm" type="string" is-multi-value="yes"/>
 </class>

</oks-schema>
