# Copy this file to .env and fill in your provider credentials.
# Never commit the resulting .env file.

# API key for an OpenAI-compatible LLM provider.
LLM_API_KEY=replace_with_your_api_key

# The model made available by your provider.
LLM_MODEL=mimo-v2.5-pro

# OpenAI-compatible Chat Completions API base URL.
LLM_BASE_URL=https://api.xiaomimimo.com/v1
