@startuml
title OKS MCP Server — Use-Case Diagram

skinparam monochrome true
skinparam shadowing false
skinparam backgroundColor white
skinparam defaultFontName Arial
skinparam packageStyle rectangle
left to right direction

actor "Developer /\nTeam Member" as Developer
actor "Coding Agent\n(Claude Code, Codex, etc.)" as Agent
actor "LLM API" as LLM

rectangle "OKS MCP Server" {
  usecase "Connect through\nMCP endpoint" as UC1
  usecase "Submit natural-language\nOKS question" as UC2
  usecase "Resolve a follow-up into\na complete question" as UC3
  usecase "Translate question to\nOksQuery" as UC4
  usecase "Validate and repair\nOksQuery" as UC5
  usecase "Execute read-only query\nagainst OKS" as UC6
  usecase "Return filtered structured\nresults" as UC7
  usecase "Query a historical\nconfiguration version" as UC8
  usecase "Probe CERN/TDAQ\nenvironment" as UC9
}

Developer --> UC1
Developer --> UC2
Developer --> UC9
Agent --> UC1
Agent --> UC2
Agent --> UC3
Agent --> UC7
LLM --> UC4
LLM --> UC5

UC2 .> UC4 : <<include>>
UC4 .> UC5 : <<include>>
UC5 .> UC6 : <<include>>
UC6 .> UC7 : <<include>>
UC8 .> UC6 : <<extend>>

note right of UC3
  Conversation memory and follow-up
  resolution belong to the host agent.
  The MCP server remains stateless.
end note

note bottom of UC6
  The server exposes only approved data files
  and read-only query execution.
end note
@enduml
